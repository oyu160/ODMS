{
  "name": "dms",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:https": "next dev --experimental-https",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "check": "prisma generate && tsc --noEmit --pretty false -p tsconfig.check.json > check.txt 2>&1; echo 'Шалгалт дууслаа: check.txt'",
    "db:patch": "tsx prisma/patch.ts",
    "db:routing": "tsx prisma/routing-rules.ts",
    "perf": "tsx --env-file=.env prisma/perf.ts",
    "backup": "sh scripts/backup.sh",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "db:extras": "prisma db execute --file prisma/db-extras.sql --schema prisma/schema.prisma"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.0",
    "lucide-react": "^0.544.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "prisma": "^6.16.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}