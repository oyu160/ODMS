# PostgreSQL холболт (docker-compose.yml-тэй тохирно)
DATABASE_URL="postgresql://dms:dms_password@localhost:5432/dms?schema=public"

# Сешн шифрлэх нууц түлхүүр — дор хаяж 32 тэмдэгт. Жишээ: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-32chars"

# Хүний нөөцийн системийн API (одоохондоо хоосон байж болно)
HR_API_URL=""
HR_API_KEY=""
