# HTTPS urwuu proksi (FBSh-03: ugugdliig suljeegeer shifrlej damjuulna)
# Gerchilgee /data dotor hadgalagdaj, hugatsaa duusahaas umnu awtomataar shinechlegdene.
{$DMS_DOMAIN:localhost} {
	tls {$DMS_TLS:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Failiin deed hemjee 20 MB + mayagtiin ugugdul (FBSh-07)
	request_body {
		max_size 25MB
	}

	reverse_proxy app:3000
}
